{
    "$schema": "https://go.kicad.org/api/schemas/v1",
    "identifier": "com.github.haydenhu.sch-ai-assistant",
    "name": "Sch AI Pin Assistant",
    "description": "AI-powered schematic symbol creation from datasheet pin diagrams.",
    "type": "plugin",
    "runtime": {
        "type": "python",
        "min_version": "3.9"
    },
    "actions": [
        {
            "identifier": "sch_ai_assistant",
            "name": "AI Pin Assistant",
            "description": "Analyze chip datasheet pin diagrams with AI and generate KiCad schematic symbols",
            "show-button": true,
            "scopes": ["symbol", "schematic", "pcb"],
            "entrypoint": "plugins/sch_ai_assistant.py",
            "icons-light": ["plugins/icon.png", "plugins/icon@2x.png"],
            "icons-dark": ["plugins/icon.png", "plugins/icon@2x.png"]
        }
    ]
}
